+    def _create_graph_memopt(self):
+        """cuda_graph_memopt manager (env CGMO), only for the plain CUDA runner.
+
+        Runners that override capture/replay (NPU, EAGLE draft, ...) keep stock behaviour: a
+        folded graph has no unrolled executable, so every replay site has to go through the manager.
+        """
+        self._cgmo_key = None
+        self._cgmo_group = None
+        from sglang.srt.model_executor.cgmo_hook import cgmo_requested, create_graph_memopt
+
+        if not cgmo_requested():
+            return None
+        cls = type(self)
+        plain = all(
+            getattr(cls, name) is getattr(CudaGraphRunner, name)
+            for name in ("_capture_graph", "_create_device_graph", "capture_one_batch_size", "replay")
+        )
+        if not plain or not str(self.device).startswith("cuda"):
+            logger.warning("CGMO is set but %s does not use the stock CUDA graph path; disabled", cls.__name__)
+            return None
+        return create_graph_memopt()
+
