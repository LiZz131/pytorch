+__attribute__((visibility("default"))) void tmo_set_capture_plan_at(
+    const size_t* sizes,
+    const size_t* offsets,
+    size_t n,
+    size_t arena_bytes,
+    void* base) {
+  tmo_set_capture_plan(sizes, offsets, n, arena_bytes);
+  auto& plan = tmo_plan();
+  std::lock_guard<std::mutex> guard(plan.mu);
+  plan.arena_ready = base != nullptr;
